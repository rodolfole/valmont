---
---

<section id="story" class="relative isolate overflow-hidden bg-ink-950 py-32 sm:py-40">
  <!-- Starry backdrop -->
  <div class="starfield absolute inset-0 -z-10 opacity-80"></div>
  <div
    class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top,rgba(45,74,107,0.35),transparent_60%)]"
  >
  </div>

  <div class="mx-auto max-w-3xl px-6 text-center">
    <svg
      viewBox="0 0 24 24"
      class="mx-auto mb-10 h-6 w-6 text-ember/70"
      fill="none"
      stroke="currentColor"
      stroke-width="1.2"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M5 15c1.5-3 4-4.5 7-4.5s5.5 1.5 7 4.5M5 9c1.5-2 4-3 7-3s5.5 1 7 3"
      />
    </svg>

    <blockquote class="text-balance font-display text-3xl leading-snug text-snow sm:text-4xl lg:text-5xl">
      “We didn't want to leave. Snow on the trees, stars overhead, and the
      quiet we'd been chasing for so long.”
    </blockquote>

    <footer class="mt-10 flex flex-col items-center gap-3">
      <span class="block h-px w-12 bg-frost-500"></span>
      <p class="text-sm text-frost-300">Alex &amp; Jordan · Stayed January 2025</p>
    </footer>
  </div>
</section>
