---
const amenities = [
  {
    title: "Surrounded by nature",
    icon: "tree",
  },
  {
    title: "Private sauna",
    icon: "sauna",
  },
  {
    title: "Mountain views",
    icon: "mountain",
  },
  {
    title: "Outdoor firepit",
    icon: "fire",
  },
  {
    title: "Coffee & tea",
    icon: "cup",
  },
  {
    title: "Curated comforts",
    icon: "shield",
  },
];

// Inline SVG paths keyed by icon name — keeps this component self-contained.
const paths: Record<string, string> = {
  tree: "M12 3l5 7h-3l4 6h-4v5h-4v-5H6l4-6H7l5-7z",
  sauna:
    "M5 20V8a3 3 0 013-3h0a3 3 0 013 3M11 20V6m4 14V8a3 3 0 013-3h0a3 3 0 013 3M15 20v-4m0 0h2M7 20h14",
  mountain: "M3 20l5-8 4 5 3-4 6 7H3z",
  fire: "M12 3c1 4 5 5 5 9a5 5 0 11-10 0c0-2 1-3 2-4 0 2 1 3 2 3 0-3 0-5 1-8z",
  cup: "M5 9h12v6a4 4 0 01-4 4H9a4 4 0 01-4-4V9zm12 2h2a2 2 0 010 4h-2M8 5v2m4-3v3m4-2v2",
  shield: "M12 3l8 3v6c0 5-4 8-8 9-4-1-8-4-8-9V6l8-3z",
};
---

<section id="amenities" class="relative bg-ink-900 py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-6">
    <div class="mb-16 max-w-2xl">
      <p class="mb-3 text-xs tracking-[0.4em] uppercase text-frost-400">
        Amenities
      </p>
      <h2 class="font-display text-3xl text-snow sm:text-4xl lg:text-5xl">
        The things you didn't know you needed.
      </h2>
    </div>

    <ul class="grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 lg:grid-cols-6">
      {amenities.map((a) => (
        <li class="group flex flex-col items-start gap-4">
          <span
            class="grid h-12 w-12 place-items-center rounded-full border border-white/15 text-ember transition group-hover:border-ember group-hover:bg-ember/10"
          >
            <svg
              viewBox="0 0 24 24"
              class="h-5 w-5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d={paths[a.icon]}></path>
            </svg>
          </span>
          <p class="text-sm leading-snug text-frost-200">{a.title}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
