---
import "../styles/global.css";
import { getImage } from "astro:assets";
import heroSrc from "../assets/images/alpine_cabin_night_optimized.webp";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Valmont — A winter cabin built for slow evenings",
  description = "Valmont is a hand-built winter cabin tucked into the alpine forest. Cedar walls, soft light, and a place that holds space for doing nothing at all.",
} = Astro.props;

// Pre-compute the smallest hero variant (640w) so the browser can start the
// preload immediately. <Image> in the hero section adds srcset on top.
const heroPreload = await getImage({
  src: heroSrc,
  width: 640,
  format: "webp",
  quality: 72,
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#050608" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- LCP: warm up the connection and preload the hero's smallest variant -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500&family=Inter:wght@300;400;500;600&display=swap"
    />
    <link
      rel="preload"
      as="image"
      href={heroPreload.src}
      fetchpriority="high"
    />

    <title>{title}</title>
  </head>
  <body class="bg-ink-950 text-frost-100 antialiased">
    <slot />
  </body>
</html>
