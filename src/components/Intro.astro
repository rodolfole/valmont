---
const stats = [
  { label: "Sleeps", value: "4" },
  { label: "Sauna", value: "Private" },
  { label: "Fireplace", value: "Wood" },
  { label: "WiFi", value: "Fast" },
];

const detail = [
  { k: "Location", v: "Aspen Ridge, Colorado" },
  { k: "Season", v: "December – April" },
  { k: "From", v: "$640 / night" },
];
---

<section id="cabin" class="relative bg-ink-950 py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-6">
    <div class="grid gap-12 lg:grid-cols-[1.2fr_1fr] lg:gap-20">
      <div class="max-w-2xl">
        <p class="mb-6 text-xs tracking-[0.4em] uppercase text-frost-400">
          The Cabin
        </p>
        <h2
          class="text-balance font-display text-4xl leading-[1.05] text-snow sm:text-5xl lg:text-6xl"
        >
          A winter cabin built for slow evenings.
        </h2>
        <p class="mt-8 max-w-xl text-pretty text-base leading-relaxed text-frost-300 sm:text-lg">
          Valmont sits on a quiet ridge above the spruce line — far enough from
          the village that the only sound after dark is the fire settling into
          itself. Inside, warm wood and soft light. Outside, the kind of cold
          you only find when nobody is selling it to you.
        </p>

        <div class="mt-10 flex flex-wrap items-center gap-4">
          <a
            href="#book"
            class="rounded-full bg-snow px-6 py-3 text-sm font-medium text-ink-950 transition hover:bg-ember"
          >
            Book Now
          </a>
          <a
            href="#story"
            class="group inline-flex items-center gap-2 text-sm text-frost-200 transition hover:text-snow"
          >
            Read the story
            <span
              class="block h-px w-8 bg-frost-400 transition group-hover:w-12 group-hover:bg-ember"
            ></span>
          </a>
        </div>
      </div>

      <div class="lg:pl-6">
        <ul class="grid grid-cols-2 gap-x-8 gap-y-10 border-t border-white/10 pt-10 sm:grid-cols-4 lg:grid-cols-2 lg:gap-x-6 lg:gap-y-12">
          {stats.map((s) => (
            <li class="flex flex-col items-start gap-3">
              <span class="grid h-9 w-9 place-items-center rounded-full border border-white/15 text-ember">
                <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" d="M6 20h12M9 20v-6a3 3 0 016 0v6M5 14l7-8 7 8" />
                </svg>
              </span>
              <div>
                <p class="font-display text-2xl text-snow">{s.value}</p>
                <p class="mt-1 text-xs tracking-[0.2em] uppercase text-frost-400">
                  {s.label}
                </p>
              </div>
            </li>
          ))}
        </ul>

        <dl class="mt-12 grid grid-cols-1 gap-4 border-t border-white/10 pt-8 text-sm sm:grid-cols-3">
          {detail.map((d) => (
            <div>
              <dt class="text-xs tracking-[0.2em] uppercase text-frost-400">
                {d.k}
              </dt>
              <dd class="mt-1 text-frost-100">{d.v}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </div>
</section>
